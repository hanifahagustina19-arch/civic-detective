            const container = document.getElementById('team-scoreboard-container');
            container.innerHTML = '';

            teams.forEach(t => {
                container.innerHTML += `
                    <div class="bg-gray-950 border ${t.solved ? 'border-emerald-500 bg-emerald-950/20' : 'border-gray-800'} p-4 rounded-xl flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-bold text-amber-400 flex items-center gap-1">${t.badge} ${t.name}</span>
                                ${t.solved ? '<span class="text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 px-2 py-0.5 rounded font-mono">SOLVED</span>' : ''}
                            </div>
                            <div class="text-2xl font-black text-white font-mono">${t.score} <span class="text-xs font-normal text-gray-400">Pts</span></div>
                            <div class="text-xs text-gray-400 mt-1">Bukti: <strong class="text-amber-400">${t.evidenceCount}/5</strong></div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-gray-800/80 flex items-center justify-between gap-1">
                            <button onclick="updateScore(${t.id}, 10)" class="text-[11px] px-2 py-1 bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 rounded border border-emerald-500/40">+10</button>
                            <button onclick="updateScore(${t.id}, 15)" class="text-[11px] px-2 py-1 bg-cyan-500/20 text-cyan-300 hover:bg-cyan-500/30 rounded border border-cyan-500/40">+15</button>
                            <button onclick="updateScore(${t.id}, -10)" class="text-[11px] px-2 py-1 bg-red-500/20 text-red-300 hover:bg-red-500/30 rounded border border-red-500/40">-10</button>
                            <button onclick="addEvidenceCount(${t.id})" class="text-[11px] px-2 py-1 bg-amber-500/20 text-amber-300 hover:bg-amber-500/30 rounded border border-amber-500/40">+Bukti</button>
                        </div>
                    </div>
                `;
            });
        }

        function updateScore(teamId, pts) {
            playSynthSound('click');
            const team = teams.find(t => t.id === teamId);
            if (team) {
                team.score = Math.max(0, team.score + pts);
                renderScoreboard();
            }
        }

        function addEvidenceCount(teamId) {
            playSynthSound('click');
            const team = teams.find(t => t.id === teamId);
            if (team) {
                team.evidenceCount = Math.min(5, team.evidenceCount + 1);
                renderScoreboard();
            }
        }

        function resetScores() {
            teams.forEach(t => { t.score = 0; t.evidenceCount = 0; t.solved = false; });
            renderScoreboard();
        }

        /* Surprise Card Draw */
        function drawSurpriseCard() {
            playSynthSound('reveal');
            const randomCard = surpriseCards[Math.floor(Math.random() * surpriseCards.length)];
            const display = document.getElementById('surprise-display');
            
            display.innerHTML = `
                <div class="animate-in zoom-in duration-300">
                    <h3 class="text-2xl font-black text-amber-400 mb-2">${randomCard.title}</h3>
                    <p class="text-sm text-gray-200 leading-relaxed">${randomCard.desc}</p>
                </div>
            `;
            confetti({ particleCount: 50, spread: 60, origin: { y: 0.7 } });
        }

        /* Render Cases Library */
        function renderCasesLibrary() {
            const container = document.getElementById('all-cases-grid');
            container.innerHTML = '';

            Object.keys(casesData).forEach(id => {
                const c = casesData[id];
                container.innerHTML += `
                    <div class="bg-gray-950 border border-gray-800 p-5 rounded-2xl flex flex-col justify-between">
                        <div>
                            <span class="text-xs font-mono text-amber-400 font-bold block mb-1">KASUS ${id}</span>
                            <h3 class="text-lg font-bold text-white mb-2">${c.title}</h3>
                            <p class="text-xs text-gray-400 line-clamp-4 leading-relaxed mb-4">${c.situation}</p>
                        </div>
                        <div class="pt-3 border-t border-gray-800 text-xs text-cyan-400">
                            <strong>Konstitusi:</strong> ${c.pasal}
                        </div>
                    </div>
                `;
            });
        }

        /* Render Challenges Grid */
        function renderChallengesGrid() {
            const container = document.getElementById('challenges-grid');
            container.innerHTML = '';

            challenges.forEach(ch => {
                container.innerHTML += `
                    <div class="bg-gray-950 border border-gray-800 p-5 rounded-2xl flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-mono text-amber-400 font-bold">🔐 TANTANGAN ${ch.id}</span>
                                <span class="text-xs bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2 py-0.5 rounded">Waktu: ${ch.time}</span>
                            </div>
                            <h3 class="text-lg font-bold text-white mb-2">${ch.title}</h3>
                            <p class="text-xs text-gray-300 leading-relaxed mb-4">${ch.desc}</p>
                        </div>
                        <div class="pt-3 border-t border-gray-800 flex items-center justify-between text-xs text-emerald-400 font-bold">
                            <span>Reward: +${ch.points} Poin + 1 Bukti</span>
                            <i data-lucide="award" class="w-4 h-4"></i>
                        </div>
                    </div>
                `;
            });
        }

        /* Award Calculation */
        function generateAwards() {
            playSynthSound('success');
            const sorted = [...teams].sort((a,b) => b.score - a.score);
            document.getElementById('award-master').innerText = `${sorted[0].name} (${sorted[0].score} Pts)`;
            document.getElementById('award-evidence').innerText = `${sorted[1] ? sorted[1].name : sorted[0].name}`;
            document.getElementById('award-critical').innerText = `${sorted[2] ? sorted[2].name : sorted[0].name}`;
            document.getElementById('award-teamwork').innerText = `Semua Kelompok TKR 1`;
            confetti({ particleCount: 150, spread: 90, origin: { y: 0.5 } });
        }

        /* Printable Materials Generation */
        function generatePrintableKit() {
            const container = document.getElementById('printable-cards-content');
            let html = `<div class="grid grid-cols-2 gap-4">`;

            Object.keys(casesData).forEach(id => {
                const c = casesData[id];
                html += `
                    <div class="border-2 border-black p-4 rounded-lg page-break">
                        <div class="text-xs font-bold uppercase border-b border-black pb-1 mb-2">MAP KASUS ${id}: ${c.title}</div>
                        <p class="text-xs mb-3"><strong>Situasi:</strong> ${c.situation}</p>
                        <div class="text-xs"><strong>Target Analisis:</strong> ${c.target} (${c.pasal})</div>
                    </div>
                `;
            });
            html += `</div>`;
            container.innerHTML = html;
        }

        /* Timer Control */
        function toggleTimer() {
            const btn = document.getElementById('timer-btn');
            if (isTimerRunning) {
                clearInterval(timerInterval);
                isTimerRunning = false;
                btn.innerText = 'Start';
            } else {
                isTimerRunning = true;
                btn.innerText = 'Pause';
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        const mins = Math.floor(timerSeconds / 60);
                        const secs = timerSeconds % 60;
                        document.getElementById('timer-display').innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                    } else {
                        clearInterval(timerInterval);
                    }
                }, 1000);
            }
        }

        /* Initialization on Load */
        window.onload = function() {
            lucide.createIcons();
            renderBoardCards();
            renderScoreboard();
            renderCasesLibrary();
            renderChallengesGrid();
            generatePrintableKit();

            window.addEventListener('resize', renderStringLines);
        };
    </script>
</body>
</html>
